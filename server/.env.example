ECMP_MODE=real
# Experimental exact-version lab only; requires --lab-v7 on the agent too.
ECMP_V7_LAB_ENABLED=0
ECMP_AI_MODE=simulated
ECMP_DATABASE=server/mvp.sqlite3
ECMP_TECHNICIAN_ID=technician-1
ECMP_AGENT_ID=agent-1
# Three distinct random secrets, at least 32 characters. Never commit .env.
ECMP_TECHNICIAN_TOKEN=
ECMP_AGENT_TOKEN=
ECMP_GENERATOR_TOKEN=
ECMP_GENERATOR_URL=http://127.0.0.1:8091/api/ecmp.php
OPENAI_MODEL=gpt-4o-mini
# Required only when ECMP_AI_MODE=openai; loaded lazily on first AI operation.
# No automatic switch to simulated on missing key, refusal, timeout or invalid output.
OPENAI_API_KEY=

# Free OpenRouter provider: ECMP_AI_MODE=openrouter (or --ai openrouter).
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_X_TITLE=Soporte remoto inteligente
